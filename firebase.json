{
 "hosting": {
  "public": ".",
  "ignore": [
   "firebase.json",
   "firestore.rules",
   "notifier/**",
   ".github/**",
   "README.md",
   "**/.*",
   "**/node_modules/**"
  ],
  "headers": [
   {
    "source": "/sw.js",
    "headers": [
     {
      "key": "Cache-Control",
      "value": "no-cache"
     }
    ]
   }
  ]
 },
 "firestore": {
  "rules": "firestore.rules"
 }
}